{
    "format": "lvdrfcad-library",
    "version": 1,
    "name": "rf-system",
    "description": "Behavioural RF system blocks for budget, spur and linear RF analyses",
    "components": [
        {
            "id": "amplifier",
            "name": "Amplifier",
            "category": "RF/Amplifiers",
            "description": "Behavioural amplifier",
            "referencePrefix": "A",
            "pins": [
                { "name": "in" },
                { "name": "out" }
            ],
            "parameters": [
                { "name": "gain", "label": "Gain", "unit": "dB", "default": "15", "shown": true },
                { "name": "nf", "label": "Noise figure", "unit": "dB", "default": "2", "shown": true },
                { "name": "oip3", "label": "Output IP3", "unit": "dBm", "default": "30" },
                { "name": "oip2", "label": "Output IP2", "unit": "dBm", "default": "45" },
                { "name": "op1db", "label": "Output P1dB", "unit": "dBm", "default": "18" },
                { "name": "isolation", "label": "Reverse isolation", "unit": "dB", "default": "40" },
                { "name": "gain_slope", "label": "Gain slope around freq", "unit": "dB/GHz", "default": "0" },
                { "name": "nf_slope", "label": "Noise figure slope around freq", "unit": "dB/GHz", "default": "0" },
                { "name": "freq", "label": "Reference frequency of the slopes", "unit": "Hz", "default": "1GHz" },
                { "name": "rl_in", "label": "Input return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "rl_out", "label": "Output return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "polygon", "points": [[-20, -20], [20, 0], [-20, 20]], "fill": "none" }
                ],
                "pins": [
                    { "pin": "in", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "out", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "amplifier" }
            ]
        },
        {
            "id": "attenuator",
            "name": "Attenuator",
            "category": "RF/Passive",
            "description": "Matched fixed attenuator",
            "referencePrefix": "AT",
            "pins": [
                { "name": "in" },
                { "name": "out" }
            ],
            "parameters": [
                { "name": "il", "label": "Attenuation", "unit": "dB", "default": "3", "shown": true },
                { "name": "il_slope", "label": "Insertion loss slope around freq", "unit": "dB/GHz", "default": "0" },
                { "name": "freq", "label": "Reference frequency of the slopes", "unit": "Hz", "default": "1GHz" },
                { "name": "rl_in", "label": "Input return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "rl_out", "label": "Output return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "rect", "from": [-20, -20], "to": [20, 20], "fill": "none" },
                    { "type": "line", "points": [[-20, 0], [-14, 0]] },
                    {
                        "type": "line",
                        "points": [[-14, 0], [-12, -5], [-8, 5], [-4, -5], [0, 5], [4, -5], [8, 5], [12, -5], [14, 0]]
                    },
                    { "type": "line", "points": [[14, 0], [20, 0]] }
                ],
                "pins": [
                    { "pin": "in", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "out", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "attenuator" }
            ]
        },
        {
            "id": "filter",
            "name": "Filter",
            "category": "RF/Filters",
            "description": "Behavioural lowpass, highpass, bandpass or bandstop filter",
            "referencePrefix": "F",
            "pins": [
                { "name": "in" },
                { "name": "out" }
            ],
            "parameters": [
                {
                    "name": "type",
                    "label": "Type",
                    "unit": "",
                    "default": "bandpass",
                    "shown": true,
                    "choices": ["lowpass", "highpass", "bandpass", "bandstop"]
                },
                {
                    "name": "response",
                    "label": "Response",
                    "unit": "",
                    "default": "butterworth",
                    "choices": ["ideal", "butterworth", "chebyshev"]
                },
                { "name": "order", "label": "Order", "unit": "", "default": "5" },
                {
                    "name": "fc",
                    "label": "Cutoff (LP/HP) or centre frequency (BP/BS)",
                    "unit": "Hz",
                    "default": "1GHz",
                    "shown": true
                },
                { "name": "bw", "label": "Bandwidth (BP/BS)", "unit": "Hz", "default": "100MHz" },
                { "name": "il", "label": "Passband insertion loss", "unit": "dB", "default": "1" },
                { "name": "ripple", "label": "Passband ripple (Chebyshev)", "unit": "dB", "default": "0.1" },
                { "name": "rejection", "label": "Maximum stopband attenuation", "unit": "dB", "default": "80" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "rect", "from": [-20, -20], "to": [20, 20], "fill": "none" },
                    { "type": "arc", "center": [-4, -8], "radius": 4, "startAngle": 0, "spanAngle": 180 },
                    { "type": "arc", "center": [4, -8], "radius": 4, "startAngle": 180, "spanAngle": 180 },
                    { "type": "arc", "center": [-4, 0], "radius": 4, "startAngle": 0, "spanAngle": 180 },
                    { "type": "arc", "center": [4, 0], "radius": 4, "startAngle": 180, "spanAngle": 180 },
                    { "type": "arc", "center": [-4, 8], "radius": 4, "startAngle": 0, "spanAngle": 180 },
                    { "type": "arc", "center": [4, 8], "radius": 4, "startAngle": 180, "spanAngle": 180 }
                ],
                "pins": [
                    { "pin": "in", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "out", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "filter" }
            ]
        },
        {
            "id": "mixer",
            "name": "Mixer",
            "category": "RF/Mixers",
            "description": "Behavioural mixer: rf and lo in, if out",
            "referencePrefix": "MX",
            "pins": [
                { "name": "rf" },
                { "name": "lo" },
                { "name": "if" }
            ],
            "parameters": [
                { "name": "gain", "label": "Conversion gain", "unit": "dB", "default": "-7", "shown": true },
                { "name": "nf", "label": "Noise figure (SSB)", "unit": "dB", "default": "7" },
                { "name": "iip3", "label": "Input IP3", "unit": "dBm", "default": "15" },
                { "name": "lo_power", "label": "Nominal LO drive", "unit": "dBm", "default": "13" },
                { "name": "lo_rf_isolation", "label": "LO to RF isolation", "unit": "dB", "default": "35" },
                { "name": "lo_if_isolation", "label": "LO to IF isolation", "unit": "dB", "default": "30" },
                { "name": "rf_if_isolation", "label": "RF to IF isolation", "unit": "dB", "default": "25" },
                { "name": "side", "label": "LO side", "unit": "", "default": "low", "choices": ["low", "high"] },
                { "name": "product", "label": "Wanted product", "unit": "", "default": "auto", "shown": true, "choices": ["auto", "difference", "sum"] },
                { "name": "spur_table", "label": "Spur table file", "unit": "", "default": "", "file": true },
                { "name": "rl_rf", "label": "RF return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "rl_lo", "label": "LO return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "rl_if", "label": "IF return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "circle", "center": [0, 0], "radius": 20, "fill": "none" },
                    { "type": "line", "points": [[-14, -14], [14, 14]] },
                    { "type": "line", "points": [[-14, 14], [14, -14]] }
                ],
                "pins": [
                    { "pin": "rf", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "lo", "at": [0, 30], "length": 10, "direction": "up" },
                    { "pin": "if", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [30, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "mixer" }
            ]
        },
        {
            "id": "source",
            "name": "Signal source",
            "category": "RF/Sources",
            "description": "CW signal source driving a budget chain",
            "referencePrefix": "SRC",
            "pins": [
                { "name": "out" }
            ],
            "parameters": [
                { "name": "freq", "label": "Frequency", "unit": "Hz", "default": "1GHz", "shown": true },
                { "name": "power", "label": "Power", "unit": "dBm", "default": "-30", "shown": true },
                { "name": "z0", "label": "Source impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "circle", "center": [0, 0], "radius": 20, "fill": "none" },
                    { "type": "arc", "center": [-5, 0], "radius": 5, "startAngle": 0, "spanAngle": 180 },
                    { "type": "arc", "center": [5, 0], "radius": 5, "startAngle": 180, "spanAngle": 180 }
                ],
                "pins": [
                    { "pin": "out", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "source" }
            ]
        },
        {
            "id": "lo",
            "name": "Local oscillator",
            "category": "RF/Sources",
            "description": "Local oscillator; its phase-noise file feeds the budget's phase-noise and reciprocal-mixing figures",
            "referencePrefix": "LO",
            "pins": [
                { "name": "out" }
            ],
            "parameters": [
                { "name": "freq", "label": "Frequency", "unit": "Hz", "default": "2GHz", "shown": true },
                { "name": "power", "label": "Power", "unit": "dBm", "default": "13", "shown": true },
                { "name": "phase_noise", "label": "Phase noise file (offset Hz, L dBc/Hz)", "unit": "", "default": "", "file": true },
                { "name": "z0", "label": "Source impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "circle", "center": [0, 0], "radius": 20, "fill": "none" },
                    { "type": "text", "at": [0, 0], "text": "LO", "size": 10, "anchor": "center" }
                ],
                "pins": [
                    { "pin": "out", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "lo" }
            ]
        },
        {
            "id": "splitter",
            "name": "Power splitter",
            "category": "RF/Passive",
            "description": "Two-way in-phase power splitter",
            "referencePrefix": "SPL",
            "pins": [
                { "name": "in" },
                { "name": "out1" },
                { "name": "out2" }
            ],
            "parameters": [
                { "name": "il", "label": "Excess insertion loss", "unit": "dB", "default": "0.5", "shown": true },
                { "name": "isolation", "label": "Output isolation", "unit": "dB", "default": "20" },
                { "name": "imbalance", "label": "Amplitude imbalance", "unit": "dB", "default": "0.1" },
                { "name": "phase_imbalance", "label": "Phase imbalance", "unit": "deg", "default": "1" },
                { "name": "il_slope", "label": "Insertion loss slope around freq", "unit": "dB/GHz", "default": "0" },
                { "name": "freq", "label": "Reference frequency of the slopes", "unit": "Hz", "default": "1GHz" },
                { "name": "rl_in", "label": "Input return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "rl_out", "label": "Output return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "rect", "from": [-20, -20], "to": [20, 20], "fill": "none" },
                    { "type": "line", "points": [[-20, 0], [-4, 0]] },
                    { "type": "line", "points": [[-4, 0], [20, -10]] },
                    { "type": "line", "points": [[-4, 0], [20, 10]] }
                ],
                "pins": [
                    { "pin": "in", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "out1", "at": [30, -10], "length": 10, "direction": "left" },
                    { "pin": "out2", "at": [30, 10], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "splitter" }
            ]
        },
        {
            "id": "combiner",
            "name": "Power combiner",
            "category": "RF/Passive",
            "description": "Two-way in-phase power combiner",
            "referencePrefix": "CMB",
            "pins": [
                { "name": "in1" },
                { "name": "in2" },
                { "name": "out" }
            ],
            "parameters": [
                { "name": "il", "label": "Excess insertion loss", "unit": "dB", "default": "0.5", "shown": true },
                { "name": "isolation", "label": "Input isolation", "unit": "dB", "default": "20" },
                { "name": "imbalance", "label": "Amplitude imbalance", "unit": "dB", "default": "0.1" },
                { "name": "phase_imbalance", "label": "Phase imbalance", "unit": "deg", "default": "1" },
                { "name": "il_slope", "label": "Insertion loss slope around freq", "unit": "dB/GHz", "default": "0" },
                { "name": "freq", "label": "Reference frequency of the slopes", "unit": "Hz", "default": "1GHz" },
                { "name": "rl_in", "label": "Input return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "rl_out", "label": "Output return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "rect", "from": [-20, -20], "to": [20, 20], "fill": "none" },
                    { "type": "line", "points": [[-20, -10], [4, 0]] },
                    { "type": "line", "points": [[-20, 10], [4, 0]] },
                    { "type": "line", "points": [[4, 0], [20, 0]] }
                ],
                "pins": [
                    { "pin": "in1", "at": [-30, -10], "length": 10, "direction": "right" },
                    { "pin": "in2", "at": [-30, 10], "length": 10, "direction": "right" },
                    { "pin": "out", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "combiner" }
            ]
        },
        {
            "id": "coupler",
            "name": "Directional coupler",
            "category": "RF/Passive",
            "description": "Four-port directional coupler",
            "referencePrefix": "DC",
            "pins": [
                { "name": "in" },
                { "name": "out" },
                { "name": "cpl" },
                { "name": "iso" }
            ],
            "parameters": [
                { "name": "coupling", "label": "Coupling", "unit": "dB", "default": "20", "shown": true },
                { "name": "directivity", "label": "Directivity", "unit": "dB", "default": "25" },
                { "name": "il", "label": "Main line insertion loss", "unit": "dB", "default": "0.3" },
                { "name": "il_slope", "label": "Insertion loss slope around freq", "unit": "dB/GHz", "default": "0" },
                { "name": "freq", "label": "Reference frequency of the slopes", "unit": "Hz", "default": "1GHz" },
                { "name": "rl", "label": "Return loss of every port (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "rect", "from": [-20, -20], "to": [20, 20], "fill": "none" },
                    { "type": "line", "points": [[-20, -10], [20, -10]] },
                    { "type": "line", "points": [[-20, 10], [-10, 0], [10, 0], [20, 10]] }
                ],
                "pins": [
                    { "pin": "in", "at": [-30, -10], "length": 10, "direction": "right" },
                    { "pin": "out", "at": [30, -10], "length": 10, "direction": "left" },
                    { "pin": "cpl", "at": [-30, 10], "length": 10, "direction": "right" },
                    { "pin": "iso", "at": [30, 10], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "coupler" }
            ]
        },
        {
            "id": "switch_spdt",
            "name": "SPDT switch",
            "category": "RF/Switches",
            "description": "Single-pole double-throw switch",
            "referencePrefix": "SW",
            "pins": [
                { "name": "com" },
                { "name": "t1" },
                { "name": "t2" }
            ],
            "parameters": [
                {
                    "name": "state",
                    "label": "Selected throw",
                    "unit": "",
                    "default": "t1",
                    "shown": true,
                    "choices": ["t1", "t2"]
                },
                { "name": "select", "label": "Throw number from an expression (0: use the selected throw)", "unit": "", "default": "0" },
                { "name": "il", "label": "Insertion loss", "unit": "dB", "default": "0.5" },
                { "name": "isolation", "label": "Isolation", "unit": "dB", "default": "30" },
                { "name": "il_slope", "label": "Insertion loss slope around freq", "unit": "dB/GHz", "default": "0" },
                { "name": "freq", "label": "Reference frequency of the slopes", "unit": "Hz", "default": "1GHz" },
                { "name": "rl_in", "label": "Return loss at com (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "rl_out", "label": "Return loss at the throws (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "line", "points": [[-20, 0], [-12, 0]] },
                    { "type": "circle", "center": [-10, 0], "radius": 2, "fill": "outline" },
                    { "type": "line", "points": [[-9, -2], [8, -9]] },
                    { "type": "circle", "center": [10, -10], "radius": 2, "fill": "none" },
                    { "type": "circle", "center": [10, 10], "radius": 2, "fill": "none" },
                    { "type": "line", "points": [[12, -10], [20, -10]] },
                    { "type": "line", "points": [[12, 10], [20, 10]] }
                ],
                "pins": [
                    { "pin": "com", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "t1", "at": [30, -10], "length": 10, "direction": "left" },
                    { "pin": "t2", "at": [30, 10], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "switch_spdt" }
            ]
        },
        {
            "id": "isolator",
            "name": "Isolator",
            "category": "RF/Passive",
            "description": "Two-port isolator, forward from in to out",
            "referencePrefix": "ISO",
            "pins": [
                { "name": "in" },
                { "name": "out" }
            ],
            "parameters": [
                { "name": "il", "label": "Insertion loss", "unit": "dB", "default": "0.5", "shown": true },
                { "name": "isolation", "label": "Reverse isolation", "unit": "dB", "default": "20" },
                { "name": "il_slope", "label": "Insertion loss slope around freq", "unit": "dB/GHz", "default": "0" },
                { "name": "freq", "label": "Reference frequency of the slopes", "unit": "Hz", "default": "1GHz" },
                { "name": "rl_in", "label": "Input return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "rl_out", "label": "Output return loss (0 = ideal match)", "unit": "dB", "default": "0" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "rect", "from": [-20, -20], "to": [20, 20], "fill": "none" },
                    { "type": "line", "points": [[-12, 0], [8, 0]] },
                    { "type": "polygon", "points": [[14, 0], [6, -5], [6, 5]], "fill": "outline" }
                ],
                "pins": [
                    { "pin": "in", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "out", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [0, 30]
            },
            "models": [
                { "kind": "rf-behavioural", "block": "isolator" }
            ]
        },
        {
            "id": "circulator",
            "name": "Circulator",
            "category": "RF/Passive",
            "description": "Three-port circulator, p1 to p2 to p3 to p1",
            "referencePrefix": "CIR",
            "pins": [
                { "name": "p1" },
                { "name": "p2" },
                { "name": "p3" }
            ],
            "parameters": [
                { "name": "il", "label": "Insertion loss", "unit": "dB", "default": "0.5", "shown": true },
                { "name": "isolation", "label": "Reverse isolation", "unit": "dB", "default": "20" },
                { "name": "z0", "label": "Port impedance", "unit": "ohm", "default": "50" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "circle", "center": [0, 0], "radius": 20, "fill": "none" },
                    { "type": "arc", "center": [0, 0], "radius": 10, "startAngle": 0, "spanAngle": 180 },
                    { "type": "polygon", "points": [[10, 4], [6, -2], [14, -2]], "fill": "outline" }
                ],
                "pins": [
                    { "pin": "p1", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "p2", "at": [30, 0], "length": 10, "direction": "left" },
