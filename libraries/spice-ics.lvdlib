            "id": "regulator",
            "name": "Linear regulator (generic fixed)",
            "category": "ICs/Regulators",
            "description": "Behavioural fixed positive linear regulator: output voltage, dropout, current limit and quiescent current",
            "referencePrefix": "U",
            "pins": [{ "name": "in" }, { "name": "gnd" }, { "name": "out" }],
            "parameters": [
                { "name": "vout", "label": "Output voltage", "unit": "V", "default": "5", "shown": true },
                { "name": "vdrop", "label": "Dropout voltage", "unit": "V", "default": "2" },
                { "name": "ilim", "label": "Current limit", "unit": "A", "default": "1.5" },
                { "name": "iq", "label": "Quiescent (ground) current", "unit": "A", "default": "5m" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "rect", "from": [-30, -20], "to": [30, 20], "fill": "none" },
                    { "type": "text", "at": [0, -6], "text": "REG", "size": 7, "anchor": "center" },
                    { "type": "text", "at": [-26, 8], "text": "IN", "size": 5, "anchor": "left" },
                    { "type": "text", "at": [26, 8], "text": "OUT", "size": 5, "anchor": "right" },
                    { "type": "text", "at": [0, 14], "text": "GND", "size": 5, "anchor": "center" }
                ],
                "pins": [
                    { "pin": "in", "at": [-50, 0], "length": 20, "direction": "right" },
                    { "pin": "gnd", "at": [0, 40], "length": 20, "direction": "up" },
                    { "pin": "out", "at": [50, 0], "length": 20, "direction": "left" }
                ],
                "referenceAt": [0, -30],
                "valueAt": [40, 30]
            },
            "models": [
                {
                    "kind": "spice",
                    "template": "X{ref} {pin:in} {pin:gnd} {pin:out} lvd_linreg params: vout={vout} vdrop={vdrop} ilim={ilim} iq={iq}",
                    "subcircuit": ".subckt lvd_linreg in gnd out params: vout=5 vdrop=2 ilim=1.5 iq=5e-3\n* behavioural positive linear regulator: output = min(vout, V(in,gnd) - vdrop), not below gnd,\n* soft current limit at ilim (100 V/A above it), sinks at most about 10 mA;\n* the output current is drawn from in and returned through gnd, plus the quiescent current iq\nBt t 0 V=V(gnd)+((({vout})-((({vout})-V(in,gnd)+({vdrop}))+sqrt((({vout})-V(in,gnd)+({vdrop}))^2+1e-4))/2)+sqrt((({vout})-((({vout})-V(in,gnd)+({vdrop}))+sqrt((({vout})-V(in,gnd)+({vdrop}))^2+1e-4))/2)^2+1e-4))/2\nBv x 0 V=V(t)-100*(I(Vs)-({ilim})+sqrt((I(Vs)-({ilim}))^2+1e-6))/2+100*(-I(Vs)-0.01+sqrt((I(Vs)+0.01)^2+1e-6))/2\nVs x y 0\nRo y out 10m\nBin in gnd I=I(Vs)+({iq})*tanh(V(in,gnd)/0.5)\n.ends lvd_linreg"
                }
            ]
        },
