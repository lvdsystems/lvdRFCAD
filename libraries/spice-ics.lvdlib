        {
            "id": "comparator",
            "name": "Comparator (push-pull)",
            "category": "ICs/Comparators",
            "description": "Behavioural comparator with hysteresis, propagation delay and rail-to-rail push-pull output: out = vcc when inp > inn",
            "referencePrefix": "U",
            "pins": [{ "name": "inp" }, { "name": "inn" }, { "name": "out" }, { "name": "vcc" }, { "name": "vee" }],
            "parameters": [
                { "name": "vhys", "label": "Input hysteresis (total)", "unit": "V", "default": "10m", "shown": true },
                { "name": "tpd", "label": "Propagation delay", "unit": "s", "default": "100n", "shown": true },
                { "name": "rout", "label": "Output resistance", "unit": "ohm", "default": "100" },
                { "name": "iq", "label": "Supply current", "unit": "A", "default": "0.5m" }
            ],
            "symbol": {
                "graphics": [
