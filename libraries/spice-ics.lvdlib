{
    "format": "lvdrfcad-library",
    "version": 1,
    "name": "spice-ics",
    "description": "Behavioural SPICE macromodels: op-amps, comparators, regulators, shunt reference and logic gates",
    "components": [
        {
            "id": "opamp_ideal",
            "name": "Ideal op-amp",
            "category": "ICs/Op-amps",
            "description": "Ideal op-amp: VCVS with very high gain from V(inp,inn) to out (referenced to ground), no supply pins or rails",
            "referencePrefix": "U",
            "pins": [{ "name": "inp" }, { "name": "inn" }, { "name": "out" }],
            "parameters": [{ "name": "gain", "label": "Open-loop gain", "unit": "V/V", "default": "1meg", "shown": true }],
            "symbol": {
                "graphics": [
                    { "type": "polygon", "points": [[-30, -30], [30, 0], [-30, 30]], "fill": "none" },
                    { "type": "line", "points": [[-26, -10], [-20, -10]] },
                    { "type": "line", "points": [[-23, -13], [-23, -7]] },
                    { "type": "line", "points": [[-26, 10], [-20, 10]] }
                ],
                "pins": [
                    { "pin": "inp", "at": [-50, -10], "length": 20, "direction": "right" },
                    { "pin": "inn", "at": [-50, 10], "length": 20, "direction": "right" },
                    { "pin": "out", "at": [50, 0], "length": 20, "direction": "left" }
                ],
                "referenceAt": [25, -25],
                "valueAt": [45, 28]
            },
            "models": [{ "kind": "spice", "template": "E{ref} {pin:out} 0 {pin:inp} {pin:inn} {gain}" }]
        },
        {
            "id": "opamp",
            "name": "Op-amp (generic macromodel)",
            "category": "ICs/Op-amps",
            "description": "Behavioural single-pole op-amp with supply pins: open-loop gain, GBW, slew rate, output swing and current limit",
            "referencePrefix": "U",
            "pins": [{ "name": "inp" }, { "name": "inn" }, { "name": "out" }, { "name": "vcc" }, { "name": "vee" }],
            "parameters": [
                { "name": "aol", "label": "Open-loop DC gain", "unit": "V/V", "default": "100k" },
                { "name": "gbw", "label": "Gain-bandwidth product", "unit": "Hz", "default": "1meg", "shown": true },
                { "name": "sr", "label": "Slew rate", "unit": "V/us", "default": "1", "shown": true },
                { "name": "vohr", "label": "Output headroom below vcc", "unit": "V", "default": "1.5" },
                { "name": "volr", "label": "Output headroom above vee", "unit": "V", "default": "1.5" },
                { "name": "rout", "label": "Output resistance", "unit": "ohm", "default": "50" },
                { "name": "ilim", "label": "Output current limit", "unit": "A", "default": "25m" },
                { "name": "iq", "label": "Supply current", "unit": "A", "default": "1m" },
                { "name": "rin", "label": "Differential input resistance", "unit": "ohm", "default": "1T" },
                { "name": "vos", "label": "Input offset voltage", "unit": "V", "default": "0" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "polygon", "points": [[-30, -30], [30, 0], [-30, 30]], "fill": "none" },
                    { "type": "line", "points": [[-26, -10], [-20, -10]] },
                    { "type": "line", "points": [[-23, -13], [-23, -7]] },
                    { "type": "line", "points": [[-26, 10], [-20, 10]] }
                ],
                "pins": [
                    { "pin": "inp", "at": [-50, -10], "length": 20, "direction": "right" },
                    { "pin": "inn", "at": [-50, 10], "length": 20, "direction": "right" },
                    { "pin": "out", "at": [50, 0], "length": 20, "direction": "left" },
                    { "pin": "vcc", "at": [0, -40], "length": 25, "direction": "down" },
                    { "pin": "vee", "at": [0, 40], "length": 25, "direction": "up" }
                ],
                "referenceAt": [25, -25],
                "valueAt": [45, 28]
            },
            "models": [
                {
                    "kind": "spice",
                    "template": "X{ref} {pin:inp} {pin:inn} {pin:out} {pin:vcc} {pin:vee} lvd_opamp params: aol={aol} gbw={gbw} sr={sr} vos={vos} rin={rin} rout={rout} ilim={ilim} vohr={vohr} volr={volr} iq={iq}",
                    "subcircuit": ".subckt lvd_opamp inp inn out vcc vee params: aol=1e5 gbw=1e6 sr=1 vos=0 rin=1e12 rout=50 ilim=25e-3 vohr=1.5 volr=1.5 iq=1e-3\n* single-pole behavioural op-amp: slew-limited transconductance into a 1 nF integrator,\n* output clamp vohr below vcc and volr above vee, current-limited output stage fed from the supplies\nRin inp inn {rin}\nBgm 0 n1 I=({sr*1e-3})*tanh((V(inp,inn)+({vos}))*({6.283185307*gbw/(sr*1e6)}))\nR1 n1 0 {aol/(6.283185307e-9*gbw)}\nC1 n1 0 1e-9\nBcl n1 0 I=(V(n1)-V(vcc)+({vohr})+sqrt((V(n1)-V(vcc)+({vohr}))^2+1e-6))/2-(V(vee)+({volr})-V(n1)+sqrt((V(vee)+({volr})-V(n1))^2+1e-6))/2\nBsrc vcc out I=({ilim})*(tanh((V(n1)-V(out))/({rout*ilim}))+sqrt(tanh((V(n1)-V(out))/({rout*ilim}))^2+1e-8))/2\nBsnk out vee I=({ilim})*(-tanh((V(n1)-V(out))/({rout*ilim}))+sqrt(tanh((V(n1)-V(out))/({rout*ilim}))^2+1e-8))/2\nIq vcc vee {iq}\n.ends lvd_opamp"
                }
            ]
        },
        {
            "id": "opamp_lm358",
            "name": "Op-amp, LM358-like",
            "category": "ICs/Op-amps",
            "description": "Generic preset with LM358 datasheet-typical figures: 100 dB gain, 1 MHz GBW, 0.3 V/us, output to about 20 mV above vee and 1.5 V below vcc (not a vendor model)",
            "referencePrefix": "U",
            "pins": [{ "name": "inp" }, { "name": "inn" }, { "name": "out" }, { "name": "vcc" }, { "name": "vee" }],
            "parameters": [
                { "name": "aol", "label": "Open-loop DC gain", "unit": "V/V", "default": "100k" },
                { "name": "gbw", "label": "Gain-bandwidth product", "unit": "Hz", "default": "1meg", "shown": true },
                { "name": "sr", "label": "Slew rate", "unit": "V/us", "default": "0.3", "shown": true },
                { "name": "vohr", "label": "Output headroom below vcc", "unit": "V", "default": "1.5" },
                { "name": "volr", "label": "Output headroom above vee", "unit": "V", "default": "20m" },
                { "name": "rout", "label": "Output resistance", "unit": "ohm", "default": "100" },
                { "name": "ilim", "label": "Output current limit", "unit": "A", "default": "40m" },
                { "name": "iq", "label": "Supply current", "unit": "A", "default": "350u" },
                { "name": "rin", "label": "Differential input resistance", "unit": "ohm", "default": "10meg" },
                { "name": "vos", "label": "Input offset voltage", "unit": "V", "default": "0" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "polygon", "points": [[-30, -30], [30, 0], [-30, 30]], "fill": "none" },
                    { "type": "line", "points": [[-26, -10], [-20, -10]] },
                    { "type": "line", "points": [[-23, -13], [-23, -7]] },
                    { "type": "line", "points": [[-26, 10], [-20, 10]] },
                    { "type": "text", "at": [-4, 0], "text": "358", "size": 6, "anchor": "center" }
                ],
                "pins": [
                    { "pin": "inp", "at": [-50, -10], "length": 20, "direction": "right" },
                    { "pin": "inn", "at": [-50, 10], "length": 20, "direction": "right" },
                    { "pin": "out", "at": [50, 0], "length": 20, "direction": "left" },
                    { "pin": "vcc", "at": [0, -40], "length": 25, "direction": "down" },
                    { "pin": "vee", "at": [0, 40], "length": 25, "direction": "up" }
                ],
                "referenceAt": [25, -25],
                "valueAt": [45, 28]
            },
            "models": [
                {
                    "kind": "spice",
                    "template": "X{ref} {pin:inp} {pin:inn} {pin:out} {pin:vcc} {pin:vee} lvd_opamp params: aol={aol} gbw={gbw} sr={sr} vos={vos} rin={rin} rout={rout} ilim={ilim} vohr={vohr} volr={volr} iq={iq}",
                    "subcircuit": ".subckt lvd_opamp inp inn out vcc vee params: aol=1e5 gbw=1e6 sr=1 vos=0 rin=1e12 rout=50 ilim=25e-3 vohr=1.5 volr=1.5 iq=1e-3\n* single-pole behavioural op-amp: slew-limited transconductance into a 1 nF integrator,\n* output clamp vohr below vcc and volr above vee, current-limited output stage fed from the supplies\nRin inp inn {rin}\nBgm 0 n1 I=({sr*1e-3})*tanh((V(inp,inn)+({vos}))*({6.283185307*gbw/(sr*1e6)}))\nR1 n1 0 {aol/(6.283185307e-9*gbw)}\nC1 n1 0 1e-9\nBcl n1 0 I=(V(n1)-V(vcc)+({vohr})+sqrt((V(n1)-V(vcc)+({vohr}))^2+1e-6))/2-(V(vee)+({volr})-V(n1)+sqrt((V(vee)+({volr})-V(n1))^2+1e-6))/2\nBsrc vcc out I=({ilim})*(tanh((V(n1)-V(out))/({rout*ilim}))+sqrt(tanh((V(n1)-V(out))/({rout*ilim}))^2+1e-8))/2\nBsnk out vee I=({ilim})*(-tanh((V(n1)-V(out))/({rout*ilim}))+sqrt(tanh((V(n1)-V(out))/({rout*ilim}))^2+1e-8))/2\nIq vcc vee {iq}\n.ends lvd_opamp"
                }
            ]
        },
