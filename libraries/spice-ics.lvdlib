            "models": [
                {
                    "kind": "spice",
                    "template": "X{ref} {pin:inp} {pin:inn} {pin:out} {pin:vcc} {pin:vee} lvd_comparator params: vhys={vhys} tpd={tpd} rout={rout} iq={iq}",
                    "subcircuit": ".subckt lvd_comparator inp inn out vcc vee params: vhys=10e-3 tpd=100e-9 rout=100 iq=0.5e-3\n* behavioural comparator: tanh decision with hysteresis vhys (positive feedback through the delayed state y),\n* RC delay tpd, push-pull output between vee and vcc through rout\nBx x 0 V=tanh((V(inp,inn)+({vhys/2})*V(y))/({max(vhys/20,1e-4)}))\nRd x y 1k\nCd y 0 {tpd/693}\nBo 0 out I=(V(vee)+(V(vcc)-V(vee))*(1+V(y))/2-V(out))/({rout})\nIq vcc vee {iq}\n.ends lvd_comparator"
                }
            ]
        },
