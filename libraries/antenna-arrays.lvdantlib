{
  "format": "lvdrfcad-antenna-library",
  "version": 1,
  "name": "antenna-arrays",
  "description": "Array presets: lines, planar, AESA, monopulse, ring and conformal.",
  "entries": [
    {
      "id": "ula-16",
      "name": "Linear, 16 elements, half wave",
      "kind": "array",
      "description": "Uniform linear array of 16 elements at 0.5 wavelength.",
      "data": {
        "geometry": {
          "kind": "linear",
          "unit": "lambda",
          "nx": 16,
          "dx": 0.5
        },
        "excitation": {
          "taperX": {
            "kind": "uniform"
          },
          "taperY": {
            "kind": "uniform"
          }
        }
      }
    },
    {
      "id": "ula-32-cheb",
      "name": "Linear, 32 elements, Chebyshev 30 dB",
      "kind": "array",
      "description": "Dolph-Chebyshev line with 30 dB side lobes.",
      "data": {
        "geometry": {
          "kind": "linear",
          "unit": "lambda",
          "nx": 32,
          "dx": 0.5
        },
        "excitation": {
          "taperX": {
            "kind": "chebyshev",
            "sll": 30
          },
          "taperY": {
            "kind": "uniform"
          }
        }
      }
    },
    {
      "id": "ura-8x8",
      "name": "Planar 8 x 8, uniform",
      "kind": "array",
      "description": "Rectangular 8 x 8 array at 0.5 wavelength.",
      "data": {
        "geometry": {
          "kind": "rectangular",
          "unit": "lambda",
          "nx": 8,
          "ny": 8,
          "dx": 0.5,
          "dy": 0.5,
          "aperture": "none"
        },
        "excitation": {
          "taperX": {
            "kind": "uniform"
          },
          "taperY": {
            "kind": "uniform"
          }
        }
      }
    },
    {
      "id": "ura-16x16-taylor",
      "name": "Planar 16 x 16, Taylor 30 dB",
      "kind": "array",
      "description": "Rectangular 16 x 16 array with separable Taylor 30 dB, n-bar 5 tapers.",
      "data": {
        "geometry": {
          "kind": "rectangular",
          "unit": "lambda",
          "nx": 16,
          "ny": 16,
          "dx": 0.5,
          "dy": 0.5,
          "aperture": "none"
        },
        "excitation": {
          "taperX": {
            "kind": "taylor",
            "sll": 30,
            "nbar": 5
          },
          "taperY": {
            "kind": "taylor",
            "sll": 30,
            "nbar": 5
          }
        }
      }
    },
    {
      "id": "aesa-circular-tri",
      "name": "Circular AESA, triangular lattice",
      "kind": "array",
      "description": "Radar AESA: equilateral triangular lattice (0.6 wavelength), circular aperture, radial Taylor 35 dB; scans to 60 degrees.",
      "data": {
        "geometry": {
          "kind": "triangular",
          "unit": "lambda",
          "nx": 24,
          "ny": 28,
          "dx": 0.6,
          "dy": 0.5196,
          "aperture": "circle",
          "apertureX": 6.9
        },
        "excitation": {
          "taperX": {
            "kind": "taylor",
            "sll": 35,
            "nbar": 5
          },
          "taperY": {
            "kind": "uniform"
          },
          "radial": true
        }
      }
    },
    {
      "id": "monopulse-16x16",
      "name": "Monopulse 16 x 16, azimuth difference",
      "kind": "array",
      "description": "16 x 16 array showing the azimuth difference pattern (switch to Sum for the sum beam).",
      "data": {
        "geometry": {
          "kind": "rectangular",
          "unit": "lambda",
          "nx": 16,
          "ny": 16,
          "dx": 0.5,
          "dy": 0.5,
          "aperture": "none"
        },
        "excitation": {
          "taperX": {
            "kind": "taylor",
            "sll": 30,
            "nbar": 5
          },
          "taperY": {
            "kind": "taylor",
            "sll": 30,
            "nbar": 5
          },
          "pattern": "delta-az"
        }
      }
    },
    {
      "id": "uca-16",
      "name": "Ring of 16 elements",
      "kind": "array",
      "description": "Uniform circular array: 16 elements on a ring of 1.3 wavelength radius.",
      "data": {
        "geometry": {
          "kind": "circular",
          "unit": "lambda",
          "rings": [
            {
              "radius": 1.3,
              "count": 16,
              "rotation": 0
            }
          ],
          "centreElement": false
        },
        "excitation": {
          "taperX": {
            "kind": "uniform"
          },
          "taperY": {
            "kind": "uniform"
          }
        }
      }
    },
    {
      "id": "cylinder-sector",
      "name": "Cylinder sector, 24 x 8",
      "kind": "array",
      "description": "Conformal sector on a cylinder of 3 wavelength radius: 24 columns over 120 degrees, 8 rows; steered to broadside (+x).",
      "data": {
        "geometry": {
          "kind": "cylinder",
          "unit": "lambda",
          "cylinderRadius": 3,
          "columns": 24,
          "rows": 8,
          "arc": 120,
          "dz": 0.5
        },
        "excitation": {
          "taperX": {
            "kind": "cosine-pedestal",
            "pedestal": -12
          },
          "taperY": {
            "kind": "uniform"
          },
          "steerTheta": 90,
          "steerPhi": 0
        }
      }
    }
  ]
}
