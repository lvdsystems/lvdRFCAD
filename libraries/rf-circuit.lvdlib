                ],
                "pins": [
                    { "pin": "in", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "out", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -24],
                "valueAt": [0, 24]
            },
            "models": [
                { "kind": "rf-element", "element": "stripline" }
            ]
        },
        {
            "id": "coax",
            "name": "Coaxial line",
            "category": "Transmission lines/Physical",
            "description": "Coaxial line from its dimensions",
