                { "name": "rough", "label": "Conductor rms surface roughness", "unit": "m", "default": "0" },
                {
                    "name": "backed",
                    "label": "Backside ground plane",
                    "unit": "",
                    "default": "no",
                    "choices": ["no", "yes"]
