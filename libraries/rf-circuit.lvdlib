                    "choices": ["custom", "FR-4", "RO4003C", "RO4350B", "RT/duroid 5880", "RO3003", "RO3010", "TLY-5", "I-Tera MT40", "Alumina 99.6%", "Fused silica", "GaAs", "Silicon (HR)"]
