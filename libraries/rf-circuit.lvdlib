            ]
        },
        {
            "id": "cpw",
            "name": "Coplanar waveguide",
            "category": "Transmission lines/Physical",
            "description": "Coplanar waveguide, optionally with a backside ground plane",
            "referencePrefix": "TL",
            "pins": [
                { "name": "in" },
                { "name": "out" }
            ],
            "parameters": [
                { "name": "substrate", "label": "Substrate part (empty: the values below)", "unit": "", "default": "", "text": true },
