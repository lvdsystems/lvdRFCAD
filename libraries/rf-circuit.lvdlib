        {
            "id": "substrate",
            "name": "Substrate",
            "category": "Transmission lines/Substrate",
            "description": "Substrate definition for microstrip, stripline, CPW and discontinuity parts that name it in their 'substrate' parameter; no pins and no circuit model",
            "referencePrefix": "SUB",
            "pins": [],
            "parameters": [
                {
                    "name": "material",
                    "label": "Material (custom: er and tand below)",
                    "unit": "",
                    "default": "RO4003C",
