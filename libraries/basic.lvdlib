{
    "format": "lvdrfcad-library",
    "version": 1,
    "name": "basic",
    "description": "Basic parts shared by RF and SPICE schematics: R, L, C (ideal, with parasitics, and SMD packages), ground and hierarchical ports",
    "components": [
        {
            "id": "resistor",
            "name": "Resistor",
            "category": "Passive",
            "description": "Resistor; optional parasitics: series inductance esl, parallel capacitance cp (0 = ideal)",
            "referencePrefix": "R",
            "pins": [
                { "name": "p" },
                { "name": "n" }
            ],
            "parameters": [
                { "name": "r", "label": "Resistance", "unit": "ohm", "default": "1k", "shown": true },
                { "name": "esl", "label": "Series inductance (0 = ideal)", "unit": "H", "default": "0" },
                { "name": "cp", "label": "Parallel capacitance (0 = ideal)", "unit": "F", "default": "0" }
            ],
            "symbol": {
                "graphics": [
                    {
                        "type": "line",
                        "points": [[-20, 0], [-18, -6], [-12, 6], [-6, -6], [0, 6], [6, -6], [12, 6], [18, -6], [20, 0]]
                    }
                ],
                "pins": [
                    { "pin": "p", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "n", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -20],
                "valueAt": [0, 20]
            },
            "models": [
                { "kind": "rf-element", "element": "resistor" },
                { "kind": "spice", "template": "R{ref} {pin:p} {pin:n} {r}", "parasitics": "resistor" }
            ]
        },
