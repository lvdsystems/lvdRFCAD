{
    "format": "lvdrfcad-library",
    "version": 1,
    "name": "spice-semiconductors",
    "description": "SPICE diodes, BJTs, MOSFETs and JFETs: generic parts with editable models and common real parts",
    "components": [
        {
            "id": "diode",
            "name": "Diode (generic)",
            "category": "Semiconductors/Diodes",
            "description": "Generic junction diode with editable SPICE model parameters (defaults: small-signal silicon diode)",
            "referencePrefix": "D",
            "pins": [{ "name": "a" }, { "name": "k" }],
            "parameters": [
                { "name": "is", "label": "Saturation current IS", "unit": "A", "default": "4n", "shown": true },
                { "name": "n", "label": "Emission coefficient N", "unit": "", "default": "1.9", "shown": true },
                { "name": "rs", "label": "Series resistance RS", "unit": "ohm", "default": "0.6" },
                { "name": "cjo", "label": "Zero-bias junction capacitance CJO", "unit": "F", "default": "2p" },
                { "name": "vj", "label": "Junction potential VJ", "unit": "V", "default": "0.75" },
                { "name": "m", "label": "Grading coefficient M", "unit": "", "default": "0.33" },
                { "name": "tt", "label": "Transit time TT", "unit": "s", "default": "5n" },
                { "name": "bv", "label": "Reverse breakdown voltage BV", "unit": "V", "default": "100" },
                { "name": "ibv", "label": "Current at BV", "unit": "A", "default": "100u" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "line", "points": [[-20, 0], [-10, 0]] },
                    { "type": "line", "points": [[10, 0], [20, 0]] },
                    { "type": "polygon", "points": [[-10, -10], [10, 0], [-10, 10]], "fill": "outline" },
                    { "type": "line", "points": [[10, -10], [10, 10]] }
                ],
                "pins": [
                    { "pin": "a", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "k", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -22],
                "valueAt": [0, 20]
            },
            "models": [
                {
                    "kind": "spice",
                    "template": "D{ref} {pin:a} {pin:k} lvd_dm_{ref}\n.model lvd_dm_{ref} D(is={is} n={n} rs={rs} cjo={cjo} vj={vj} m={m} tt={tt} bv={bv} ibv={ibv})"
                }
            ]
        },
        {
            "id": "zener",
            "name": "Zener diode (generic)",
            "category": "Semiconductors/Diodes",
            "description": "Generic zener: breakdown bv at test current izt; rz sets the slope above the knee",
            "referencePrefix": "D",
            "pins": [{ "name": "a" }, { "name": "k" }],
            "parameters": [
                { "name": "bv", "label": "Zener voltage at izt", "unit": "V", "default": "5.1", "shown": true },
                { "name": "izt", "label": "Test current", "unit": "A", "default": "5m" },
                { "name": "rz", "label": "Series resistance", "unit": "ohm", "default": "5" },
                { "name": "cjo", "label": "Junction capacitance", "unit": "F", "default": "100p" }
            ],
            "symbol": {
                "graphics": [
                    { "type": "line", "points": [[-20, 0], [-10, 0]] },
                    { "type": "line", "points": [[10, 0], [20, 0]] },
                    { "type": "polygon", "points": [[-10, -10], [10, 0], [-10, 10]], "fill": "outline" },
                    { "type": "line", "points": [[6, -12], [10, -10], [10, 10], [14, 12]] }
                ],
                "pins": [
                    { "pin": "a", "at": [-30, 0], "length": 10, "direction": "right" },
                    { "pin": "k", "at": [30, 0], "length": 10, "direction": "left" }
                ],
                "referenceAt": [0, -22],
                "valueAt": [0, 20]
            },
            "models": [
                {
                    "kind": "spice",
                    "template": "D{ref} {pin:a} {pin:k} lvd_dz_{ref}\n.model lvd_dz_{ref} D(is=1e-14 n=1 rs={rz} cjo={cjo} vj=0.75 m=0.33 bv={bv} ibv={izt} nbv=1.5)"
                }
            ]
        },
        {
            "id": "1n4148",
            "name": "1N4148 small-signal diode",
            "category": "Semiconductors/Diodes",
            "description": "Typical parameters for the 1N4148/1N914 fast switching diode (widely published manufacturer model)",
            "referencePrefix": "D",
            "pins": [{ "name": "a" }, { "name": "k" }],
            "symbol": {
                "graphics": [
                    { "type": "line", "points": [[-20, 0], [-10, 0]] },
