                "referenceAt": [0, -22],
                "valueAt": [0, 28]
            },
            "models": [
                {
                    "kind": "spice",
                    "template": "D{ref} {pin:a} {pin:k} lvd_1N4148",
                    "subcircuit": ".model lvd_1N4148 D(is=2.52n rs=0.568 n=1.752 cjo=4p m=0.4 vj=0.75 tt=20n bv=100 ibv=100u)"
                }
            ]
        },
        {
