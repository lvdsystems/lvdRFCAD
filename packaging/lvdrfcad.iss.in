; Inno Setup script for lvd RF cad. Generated by CMake from packaging/lvdrfcad.iss.in.
;
; 1. Build and install into a staging folder:
;      cmake --build --preset windows
;      cmake --install build --config RelWithDebInfo --prefix build/package/stage
; 2. Compile this script with Inno Setup 6:
;      "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" build\package\lvdrfcad.iss

#define AppName "lvd RF cad"
#define AppVersion "@PROJECT_VERSION@"
#define StageDir "@CMAKE_BINARY_DIR@\package\stage"

[Setup]
AppId={{6C1C5E9A-6E4B-4E39-9C34-3B2B0F2D8A71}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher=lvd RF cad contributors
DefaultDirName={autopf}\lvdRFcad
DefaultGroupName={#AppName}
LicenseFile=@CMAKE_SOURCE_DIR@\LICENSE
OutputDir=@CMAKE_BINARY_DIR@\package
OutputBaseFilename=lvdRFcad-{#AppVersion}-setup
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
PrivilegesRequiredOverridesAllowed=dialog
ChangesAssociations=yes

[Files]
Source: "{#StageDir}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[UninstallDelete]
; Python writes bytecode caches (__pycache__) next to its standard library at run time.
Type: filesandordirs; Name: "{app}\python"

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\lvdrfcad.exe"
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}"

[Registry]
Root: HKA; Subkey: "Software\Classes\.lvdproj"; ValueType: string; ValueName: ""; ValueData: "lvdRFcad.Project"; Flags: uninsdeletevalue uninsdeletekeyifempty
Root: HKA; Subkey: "Software\Classes\lvdRFcad.Project"; ValueType: string; ValueName: ""; ValueData: "lvd RF cad project"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\lvdRFcad.Project\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\lvdrfcad.exe"" ""%1"""

[Run]
Filename: "{app}\lvdrfcad.exe"; Description: "Start {#AppName}"; Flags: nowait postinstall skipifsilent
