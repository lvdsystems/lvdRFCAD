            "spice-instruments:function_generator": {
                "category": "Instruments",
                "description": "Sine, square, triangle or sawtooth voltage (V(p) - V(n) = offset + amplitude * shape) with an AC magnitude for AC analyses. Square and edges are slightly rounded so the simulator can follow them.",
                "id": "function_generator",
                "models": [
                    {
                        "instrument": "function-generator",
                        "kind": "spice",
                        "subcircuit": ".func lvd_fg_sine(x) {sin(6.283185307179586*x)}\n.func lvd_fg_square(x) {tanh(40*sin(6.283185307179586*x))}\n.func lvd_fg_triangle(x) {0.6366197723675814*asin(0.9999*sin(6.283185307179586*x))}\n.func lvd_fg_sawtooth(x) {2*(x-floor(x+0.5))}",
                        "template": "V{ref}_ac {pin:p} fg_{ref} DC 0 AC {ac}\nB{ref} fg_{ref} {pin:n} V={offset}+({amplitude})*lvd_fg_{shape}(({freq})*time+({phase})/360)"
                    }
                ],
                "name": "Function generator",
                "parameters": [
                    {
                        "choices": [
                            "sine",
                            "square",
                            "triangle",
                            "sawtooth"
                        ],
                        "default": "sine",
                        "label": "Waveform",
                        "name": "shape",
                        "shown": true
                    },
                    {
                        "default": "1kHz",
                        "label": "Frequency",
                        "name": "freq",
                        "shown": true,
                        "unit": "Hz"
                    },
                    {
                        "default": "1",
                        "label": "Amplitude (peak)",
                        "name": "amplitude",
                        "shown": true,
                        "unit": "V"
                    },
                    {
                        "default": "0",
                        "label": "Offset",
                        "name": "offset",
                        "unit": "V"
                    },
                    {
                        "default": "0",
                        "label": "Phase",
                        "name": "phase",
                        "unit": "deg"
                    },
                    {
                        "default": "1",
                        "label": "AC magnitude",
                        "name": "ac",
                        "unit": "V"
                    }
                ],
                "pins": [
                    {
                        "name": "p"
                    },
                    {
                        "name": "n"
                    }
                ],
                "referencePrefix": "FG",
                "symbol": {
                    "graphics": [
                        {
                            "fill": "background",
                            "from": [
