            "spice-instruments:oscilloscope": {
                "category": "Instruments",
                "description": "Two-channel oscilloscope on a transient result: channel voltages against the reference pin, time and volts per division with an offset per channel, and a rising-edge trigger. Like a real scope it shows the latest triggered sweep (ten divisions). Adds no circuit element.",
                "id": "oscilloscope",
                "models": [
                    {
                        "instrument": "oscilloscope",
                        "kind": "spice",
                        "template": ""
                    }
                ],
                "name": "Oscilloscope",
                "parameters": [
                    {
                        "default": "100us",
                        "label": "Time per division",
                        "name": "tdiv",
                        "shown": true,
                        "unit": "s"
                    },
                    {
                        "default": "1",
                        "label": "Channel 1 volts per division",
                        "name": "vdiv1",
                        "unit": "V"
                    },
                    {
                        "default": "1",
                        "label": "Channel 2 volts per division",
                        "name": "vdiv2",
                        "unit": "V"
                    },
                    {
                        "default": "0",
                        "label": "Channel 1 voltage at the centre line",
                        "name": "offset1",
                        "unit": "V"
                    },
                    {
                        "default": "0",
                        "label": "Channel 2 voltage at the centre line",
                        "name": "offset2",
                        "unit": "V"
                    },
                    {
                        "choices": [
                            "ch1",
                            "ch2",
                            "none"
                        ],
                        "default": "ch1",
                        "label": "Trigger source",
                        "name": "trigger"
                    },
                    {
