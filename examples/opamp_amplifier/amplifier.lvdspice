            "spice-ics:opamp_tl072": {
                "category": "ICs/Op-amps",
                "description": "Generic preset with TL072 datasheet-typical figures: 106 dB gain, 3 MHz GBW, 13 V/us, output 1.5 V from the rails (not a vendor model)",
                "id": "opamp_tl072",
                "models": [
                    {
                        "kind": "spice",
                        "subcircuit": ".subckt lvd_opamp inp inn out vcc vee params: aol=1e5 gbw=1e6 sr=1 vos=0 rin=1e12 rout=50 ilim=25e-3 vohr=1.5 volr=1.5 iq=1e-3\n* single-pole behavioural op-amp: slew-limited transconductance into a 1 nF integrator,\n* output clamp vohr below vcc and volr above vee, current-limited output stage fed from the supplies\nRin inp inn {rin}\nBgm 0 n1 I=({sr*1e-3})*tanh((V(inp,inn)+({vos}))*({6.283185307*gbw/(sr*1e6)}))\nR1 n1 0 {aol/(6.283185307e-9*gbw)}\nC1 n1 0 1e-9\nBcl n1 0 I=(V(n1)-V(vcc)+({vohr})+sqrt((V(n1)-V(vcc)+({vohr}))^2+1e-6))/2-(V(vee)+({volr})-V(n1)+sqrt((V(vee)+({volr})-V(n1))^2+1e-6))/2\nBsrc vcc out I=({ilim})*(tanh((V(n1)-V(out))/({rout*ilim}))+sqrt(tanh((V(n1)-V(out))/({rout*ilim}))^2+1e-8))/2\nBsnk out vee I=({ilim})*(-tanh((V(n1)-V(out))/({rout*ilim}))+sqrt(tanh((V(n1)-V(out))/({rout*ilim}))^2+1e-8))/2\nIq vcc vee {iq}\n.ends lvd_opamp",
                        "template": "X{ref} {pin:inp} {pin:inn} {pin:out} {pin:vcc} {pin:vee} lvd_opamp params: aol={aol} gbw={gbw} sr={sr} vos={vos} rin={rin} rout={rout} ilim={ilim} vohr={vohr} volr={volr} iq={iq}"
                    }
                ],
                "name": "Op-amp, TL072-like",
                "parameters": [
                    {
                        "default": "200k",
                        "label": "Open-loop DC gain",
                        "name": "aol",
                        "unit": "V/V"
                    },
                    {
                        "default": "3meg",
                        "label": "Gain-bandwidth product",
                        "name": "gbw",
                        "shown": true,
                        "unit": "Hz"
                    },
                    {
                        "default": "13",
                        "label": "Slew rate",
                        "name": "sr",
                        "shown": true,
                        "unit": "V/us"
                    },
                    {
                        "default": "1.5",
                        "label": "Output headroom below vcc",
                        "name": "vohr",
                        "unit": "V"
                    },
                    {
                        "default": "1.5",
                        "label": "Output headroom above vee",
                        "name": "volr",
                        "unit": "V"
                    },
                    {
                        "default": "100",
                        "label": "Output resistance",
                        "name": "rout",
                        "unit": "ohm"
                    },
                    {
                        "default": "25m",
                        "label": "Output current limit",
                        "name": "ilim",
                        "unit": "A"
                    },
                    {
                        "default": "1.4m",
                        "label": "Supply current",
                        "name": "iq",
                        "unit": "A"
                    },
                    {
                        "default": "1T",
                        "label": "Differential input resistance",
                        "name": "rin",
                        "unit": "ohm"
                    },
                    {
                        "default": "0",
                        "label": "Input offset voltage",
                        "name": "vos",
                        "unit": "V"
                    }
                ],
                "pins": [
                    {
                        "name": "inp"
                    },
                    {
                        "name": "inn"
                    },
                    {
                        "name": "out"
                    },
                    {
                        "name": "vcc"
                    },
                    {
                        "name": "vee"
                    }
                ],
                "referencePrefix": "U",
                "symbol": {
                    "graphics": [
                        {
                            "points": [
                                [
                                    -30,
                                    -30
                                ],
                                [
                                    30,
                                    0
                                ],
