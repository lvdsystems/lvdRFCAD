                        "kind": "rf-element"
                    },
                    {
                        "kind": "spice",
                        "template": "C{ref} {pin:p} {pin:n} {c}"
                    }
                ],
                "name": "Capacitor",
                "parameters": [
                    {
                        "default": "1pF",
                        "label": "Capacitance",
                        "name": "c",
                        "shown": true,
                        "unit": "F"
                    },
                    {
                        "default": "0",
                        "label": "Unloaded Q (0 = ideal)",
                        "name": "q"
                    },
                    {
