            "spice-semiconductors:1n4007": {
                "category": "Semiconductors/Diodes",
                "description": "Typical parameters for the 1N4007 1 A / 1000 V general-purpose rectifier",
                "id": "1n4007",
                "models": [
                    {
                        "kind": "spice",
                        "subcircuit": ".model lvd_1N4007 D(is=7.03n rs=34m n=1.81 eg=1.05 xti=5 cjo=10p vj=0.7 m=0.5 tt=4u bv=1000 ibv=5u)",
                        "template": "D{ref} {pin:a} {pin:k} lvd_1N4007"
                    }
                ],
                "name": "1N4007 rectifier",
                "pins": [
                    {
                        "name": "a"
                    },
                    {
                        "name": "k"
                    }
                ],
                "referencePrefix": "D",
                "symbol": {
