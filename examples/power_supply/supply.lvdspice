            "spice-ics:reg_7805": {
                "category": "ICs/Regulators",
                "description": "Behavioural 7805-like +5 V regulator with datasheet-typical 2 V dropout and 2.2 A peak current (not a vendor model)",
                "id": "reg_7805",
                "models": [
                    {
                        "kind": "spice",
                        "subcircuit": ".subckt lvd_linreg in gnd out params: vout=5 vdrop=2 ilim=1.5 iq=5e-3\n* behavioural positive linear regulator: output = min(vout, V(in,gnd) - vdrop), not below gnd,\n* soft current limit at ilim (100 V/A above it), sinks at most about 10 mA;\n* the output current is drawn from in and returned through gnd, plus the quiescent current iq\nBt t 0 V=V(gnd)+((({vout})-((({vout})-V(in,gnd)+({vdrop}))+sqrt((({vout})-V(in,gnd)+({vdrop}))^2+1e-4))/2)+sqrt((({vout})-((({vout})-V(in,gnd)+({vdrop}))+sqrt((({vout})-V(in,gnd)+({vdrop}))^2+1e-4))/2)^2+1e-4))/2\nBv x 0 V=V(t)-100*(I(Vs)-({ilim})+sqrt((I(Vs)-({ilim}))^2+1e-6))/2+100*(-I(Vs)-0.01+sqrt((I(Vs)+0.01)^2+1e-6))/2\nVs x y 0\nRo y out 10m\nBin in gnd I=I(Vs)+({iq})*tanh(V(in,gnd)/0.5)\n.ends lvd_linreg",
                        "template": "X{ref} {pin:in} {pin:gnd} {pin:out} lvd_linreg params: vout={vout} vdrop={vdrop} ilim={ilim} iq={iq}"
                    }
                ],
                "name": "7805 regulator",
                "parameters": [
                    {
                        "default": "5",
                        "label": "Output voltage",
                        "name": "vout",
                        "shown": true,
                        "unit": "V"
                    },
                    {
                        "default": "2",
                        "label": "Dropout voltage",
                        "name": "vdrop",
                        "unit": "V"
                    },
                    {
                        "default": "2.2",
                        "label": "Current limit",
                        "name": "ilim",
                        "unit": "A"
                    },
                    {
                        "default": "4.2m",
                        "label": "Quiescent (ground) current",
                        "name": "iq",
                        "unit": "A"
                    }
                ],
                "pins": [
                    {
                        "name": "in"
                    },
                    {
                        "name": "gnd"
                    },
                    {
                        "name": "out"
                    }
                ],
                "referencePrefix": "U",
                "symbol": {
                    "graphics": [
                        {
                            "from": [
                                -30,
                                -20
                            ],
                            "to": [
                                30,
                                20
                            ],
                            "type": "rect"
                        },
                        {
