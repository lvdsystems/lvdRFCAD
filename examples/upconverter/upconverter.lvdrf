            "rf-system:filter": {
                "category": "RF/Filters",
                "description": "Behavioural lowpass, highpass, bandpass or bandstop filter",
                "id": "filter",
                "models": [
                    {
                        "block": "filter",
                        "kind": "rf-behavioural"
                    }
                ],
                "name": "Filter",
                "parameters": [
                    {
                        "choices": [
