        "definitions": {
            "basic:capacitor": {
                "category": "Passive",
                "description": "Capacitor with optional finite Q (q = 0 is ideal) and series parasitics esr, esl",
                "id": "capacitor",
                "models": [
                    {
                        "element": "capacitor",
                        "kind": "rf-element"
                    },
                    {
                        "kind": "spice",
                        "parasitics": "capacitor",
                        "template": "C{ref} {pin:p} {pin:n} {c}"
                    }
                ],
                "name": "Capacitor",
                "parameters": [
