                        "default": "1pF",
                        "label": "Capacitance",
                        "name": "c",
                        "shown": true,
                        "unit": "F"
                    },
                    {
                        "default": "0",
                        "label": "Unloaded Q (0 = ideal)",
                        "name": "q"
                    },
                    {
                        "default": "1GHz",
                        "label": "Frequency at which Q applies",
                        "name": "freq",
                        "unit": "Hz"
                    },
                    {
                        "default": "0",
                        "label": "Equivalent series resistance (0 = ideal)",
                        "name": "esr",
