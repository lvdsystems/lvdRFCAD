{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows, Visual Studio 2022",
      "description": "Set QT_ROOT to the Qt kit folder, for example C:/Qt/6.11.1/msvc2022_64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "RelWithDebInfo" },
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true }
    }
  ]
}
